# --- Database (docker-compose) ---
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=text_book_illustration
DB_PORT=5432

# --- Spring Boot app ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# --- Gemini API ---
APP_GEMINI_API_KEY=your_gemini_api_key_here
APP_GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
APP_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- App-specific config ---
# local filesystem root for book text + generated images (served via a dedicated API, no S3/CDN)
FILE_STORAGE_ROOT=./data

# stuck-step timeout in seconds — RUNNING steps older than this are treated as stale and retryable
STEP_TIMEOUT_SECONDS=180

# max retries per step before /retry returns an error
MAX_RETRY_COUNT=10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:${SERVER_PORT}/api/v1
VITE_CDN_BASE_URL=http://localhost:${SERVER_PORT}
